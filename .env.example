# Runtime
NODE_ENV=development
DRY_RUN=true
PAUSE_ALL_POSTING=true
FACEBOOK_ENABLED=true
INSTAGRAM_ENABLED=true
THREADS_ENABLED=true

# Paper English
PAPER_ENGLISH_BASE_URL=https://paperbond.jjmowlab.com

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Buffer (single publishing gateway for Facebook, Instagram, and Threads)
# Get your Personal API Key from https://publish.buffer.com/settings/api
BUFFER_API_KEY=

# Optional: explicitly configured Buffer channel IDs
# Run "pnpm social buffer-channels" to discover your channel IDs.
# If omitted, channel IDs are safely auto-resolved if exactly one channel exists per service.
BUFFER_FACEBOOK_CHANNEL_ID=
BUFFER_INSTAGRAM_CHANNEL_ID=
BUFFER_THREADS_CHANNEL_ID=
